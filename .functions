# git worktree add — must be run from a folder named "main"
# usage: gwa [branch-name]  (omit to pick with fzf)
function gwa() {
	if [[ "$(basename "$PWD")" != "main" ]]; then
		echo "gwa: must be run from a directory named 'main'" >&2
		return 1
	fi
	if ! git rev-parse --git-dir &>/dev/null; then
		echo "gwa: not a git repo" >&2
		return 1
	fi

	local branch
	if [[ -n "${1:-}" ]]; then
		branch="$1"
	else
		branch=$(git branch -a \
			| sed 's|^\*\? *||; s|remotes/origin/||' \
			| sort -u \
			| fzf --prompt="branch: ")
		[[ -z "$branch" ]] && return 1
	fi

	local sanitized
	sanitized=$(printf '%s' "$branch" | tr '/' '-')

	local local_exists remote_exists
	local_exists=$(git branch --list "$branch")
	remote_exists=$(git branch -r --list "origin/$branch")

	if [[ -z "$local_exists" && -z "$remote_exists" ]]; then
		read -r -p "Branch '$branch' not found locally or on remote. Create it? [y/N] " reply
		[[ "$reply" =~ ^[Yy]$ ]] || return 1
		git worktree add -b "$branch" "../$sanitized" || return 1
	else
		git worktree add "../$sanitized" "$branch" || return 1
	fi
	cd "../$sanitized"
}

# git worktree clean — removes all worktrees except main, then cd into main
function gwc() {
	local main_path

	# Inside any worktree: git works directly
	if git rev-parse --git-dir &>/dev/null; then
		main_path=$(git worktree list --porcelain \
			| awk '/^worktree / { wt=$2 } /^branch refs\/heads\/main$/ { print wt; exit }')
	fi

	# Fallback: called from parent dir with main/ subdir
	if [[ -z "$main_path" ]] && [[ -d main ]]; then
		main_path=$(git -C main worktree list --porcelain \
			| awk '/^worktree / { wt=$2 } /^branch refs\/heads\/main$/ { print wt; exit }')
	fi

	if [[ -z "$main_path" ]]; then
		echo "gwc: no 'main' worktree found"
		return 1
	fi

	git -C "$main_path" worktree list --porcelain \
		| awk -v m="$main_path" '/^worktree / && $2 != m { print $2 }' \
		| xargs -I{} git -C "$main_path" worktree remove --force {}

	git -C "$main_path" worktree prune
	cd "$main_path"
}

function gbd() {
	git branch -D "$1" && git push origin --delete "$1"
}

# git stash + pull
function gpull() {
	git stash save && git pull && git stash pop
}

# switch to main, delete all other local branches, fetch and rebase on origin/main
# usage: gmain [branch-name]  (if given, check out that branch afterwards)
function gmain() {
	git checkout main \
		&& git branch | grep -wv main | xargs git branch -D \
		&& git fetch -p \
		&& git rebase origin/main \
		|| return 1
	if [[ -n "${1:-}" ]]; then
		git checkout "$1"
	fi
}

function roborevbranch() {
	before=$(git rev-parse HEAD)
	git pull
	after=$(git rev-parse HEAD)
	[ "$before" != "$after" ] && roborev review --branch --wait
}

# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$@"
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh
	else
		local arg=-sh
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@"
	else
		du $arg .[^.]* *
	fi
}

# Create a data URL from a file
function dataurl() {
	local mimeType=$(file -b --mime-type "$1")
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8"
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')"
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
	local port="${1:-8000}"
	sleep 1 && open "http://localhost:${port}/" &
	# Set the default Content-Type to `text/plain` instead of `application/octet-stream`
	# And serve everything as UTF-8 (although not technically correct, this doesn’t break anything for binary files)
	python3 -c $'import sys, http.server as s;\nmap = s.SimpleHTTPRequestHandler.extensions_map;\nmap[""] = "text/plain";\nfor key, value in list(map.items()):\n\tmap[key] = value + ";charset=UTF-8";\ns.test(HandlerClass=s.SimpleHTTPRequestHandler, port=int(sys.argv[1]));' "$port"
}

# Compare original and gzipped file size
function gz() {
	local origsize=$(wc -c < "$1")
	local gzipsize=$(gzip -c "$1" | wc -c)
	local ratio=$(echo "$gzipsize * 100/ $origsize" | bc -l)
	printf "orig: %d bytes\n" "$origsize"
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

# Syntax-highlight JSON strings or files
# Usage: `json '{"foo":42}'` or `echo '{"foo":42}' | json`
function json() {
	if [ -t 0 ]; then # argument
		python3 -m json.tool <<< "$*" | pygmentize -l javascript
	else # pipe
		python3 -m json.tool | pygmentize -l javascript
	fi
}

# Manually remove a downloaded app or file from the quarantine
function unquarantine() {
	for attribute in com.apple.metadata:kMDItemDownloadedDate com.apple.metadata:kMDItemWhereFroms com.apple.quarantine; do
		xattr -r -d "$attribute" "$@"
	done
}

# `o` with no arguments opens current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .
	else
		open "$@"
	fi
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# `.git`, dependency folders and tool caches, listing directories first. The
# output gets piped into `less` with color preserved, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|.venv|__pycache__|.pytest_cache|.mypy_cache|.ruff_cache|.DS_Store' --dirsfirst "$@" | less -FRX
}

# changes the name of the Terminal tab
function tabname {
	printf "\e]1;$1\a"
}

# changes the name of the Terminal tab to that of the current dir
function tabnamedir {
	printf "\e]1;%s\a" ${PWD##*/}
}

# changes the name of the Terminal window
function winname {
	echo -ne "\033]0;$1\007"
}

# usage
# pb-path node_modules/this/that.js
# it copies the path into che clipboard without trailing newline
function pb-path {
	ls $1 | tr -d "\n" | pbcopy
}

# opens a blank browser session
function ff {
	DIR="$HOME/.cache"
	mkdir -p -- "$DIR"
	TEMP="$(mktemp -d -- "$DIR/firefox-XXXXXX")"
	trap "rm -rf -- '$TEMP'" INT TERM EXIT
	/Applications/Firefox.app/Contents/MacOS/firefox -profile "$TEMP" -no-remote "$@"
}

# Git log find by commit message
function glf() { git log --all --grep="$1"; }

function port() {
	if [ $# -eq 0 ]; then
		echo "Usage: port PATH UP_TO DIR"
		return 1
	fi
	PORT=$1
	lsof -nP -i4TCP:$PORT | grep LISTEN
}

# if you have a branch named `feature-1` it will rename it to `feature-2`
# Use case: you already have closed a PR and you want to keep the branch name
# Create a timestamped git branch with optional prefix (default: fix)
# Usage: newbranch [prefix]
function newbranch() {
	local prefix="${1:-fix}"
	if [[ ! "$prefix" =~ ^[a-zA-Z0-9-]+$ ]]; then
		echo "newbranch: prefix must match [a-zA-Z0-9-]" >&2
		return 1
	fi
	git checkout -b "${prefix}-$(date "+%Y-%m-%dT%H%M")-$(jot -w %04d -r 1 1 100)"
}

# Convert string to URL-friendly slug
# Usage: slugify "Hello World! Foo" → hello-world-foo
function slugify() {
	python3 -c "
import unicodedata, re, sys
text = ' '.join(sys.argv[1:])
text = unicodedata.normalize('NFD', text)
text = ''.join(c for c in text if unicodedata.category(c) != 'Mn')
text = text.lower()
text = re.sub(r'[^a-z0-9]+', '-', text)
text = text.strip('-')
print(text)
" "$@"
}

function branch_bump {
  current_branch=$(git branch --show-current)

  if [ -n "$1" ]; then
    if [[ "$current_branch" =~ ^(.+)-([0-9]+)$ ]]; then
      base_branch="${BASH_REMATCH[1]}"
    else
      base_branch="$current_branch"
    fi
    new_suffix="$1"
    new_branch="$base_branch-$new_suffix"
  else
    if [[ $current_branch =~ ^(.+)-([0-9]+)$ ]]; then
      base_branch="${BASH_REMATCH[1]}"
      current_suffix="${BASH_REMATCH[2]}"
      new_suffix=$((current_suffix + 1))
    else
      base_branch="$current_branch"
      new_suffix=2
    fi
    new_branch="$base_branch-$new_suffix"
  fi

  git branch -m "$new_branch"

  git push origin :"$current_branch" "$new_branch"

  git push --set-upstream origin "$new_branch"

  echo "Branch renamed to $new_branch and pushed to remote."
}
