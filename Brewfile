# Homebrew packages. Install with: brew bundle --file=Brewfile
# Regenerate from what's installed: brew bundle dump --describe --force --file=Brewfile

tap "hashicorp/tap"

# Shell
brew "starship"          # Prompt, loaded by .bash_prompt
brew "fzf"               # Fuzzy finder, used by gwa and Ctrl-R
brew "helix"             # $EDITOR

# Command-line tools
brew "fd"                # Modern find
brew "gh"                # GitHub CLI, used by gv / gw
brew "git-filter-repo"   # Rewrite git history
brew "httpie"            # HTTP client
brew "jq"                # JSON processor
brew "pandoc"            # Document converter
brew "ripgrep"           # Fast grep
brew "tree"              # Used by tre

# Python and data
brew "uv"                # Packages, venvs, tools and Python versions
brew "datasette"         # Explore SQLite databases in the browser
brew "sqlite-utils"      # CLI for SQLite databases
brew "postgresql@17"     # PostgreSQL server and psql

# Other languages and dev tools
brew "cmake"             # C/C++ build system
brew "golangci-lint"     # Go linter
brew "rust"              # Rust compiler
brew "llama.cpp"         # Run local LLMs
brew "hashicorp/tap/terraform"

# Web
brew "htmlq"             # jq for HTML
brew "hugo"              # Static site generator

# PDFs and media
brew "ffmpeg"
brew "pdftk-java"        # Merge / split PDFs
brew "sox"               # Audio conversion
