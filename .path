# Homebrew: sets PATH, MANPATH, INFOPATH and HOMEBREW_PREFIX.
# Apple Silicon installs to /opt/homebrew, Intel to /usr/local.
for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$brew" ]; then
    eval "$("$brew" shellenv)"
    break
  fi
done
unset brew

# Prepend a directory to PATH if it exists and isn't already there
path_prepend() {
  [ -d "$1" ] || return
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

# GNU make (macOS ships 3.81 from 2006)
[ -n "$HOMEBREW_PREFIX" ] && path_prepend "$HOMEBREW_PREFIX/opt/make/libexec/gnubin"
export PNPM_HOME="$HOME/Library/pnpm"
path_prepend "$PNPM_HOME"
path_prepend "$HOME/work/flutter/bin"
# Your own scripts, and tools installed by uv / pipx, win over everything else
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/bin"
export PATH
unset -f path_prepend

export XDG_CONFIG_HOME="$HOME/.config"
export STARSHIP_CONFIG="$HOME/Dropbox/_TRANSFER/starship.toml"

# Version managers, each only if installed
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
command -v rbenv > /dev/null && eval "$(rbenv init - bash)"
command -v pyenv > /dev/null && eval "$(pyenv init - bash)"
