# Default editor: Helix
export EDITOR="hx"
export VISUAL="$EDITOR"

# Let less show colours (-R), quit if the output fits on one screen (-F)
# and not clear the screen afterwards (-X)
export LESS="-RFX"

# Larger bash history (allow 32³ entries; default is 500)
export HISTSIZE=32768
export HISTFILESIZE=$HISTSIZE
# Skip duplicates and commands starting with a space, and timestamp entries
export HISTCONTROL=ignoreboth
export HISTTIMEFORMAT="%F %T  "
# Make some commands not show up in history
export HISTIGNORE="ls:cd:cd -:pwd:exit:date:* --help:man *:la:history"

# British English, UTF-8
export LANG="en_GB.UTF-8"
export LC_ALL="en_GB.UTF-8"

# Highlight section titles in manual pages (bold yellow)
export LESS_TERMCAP_md=$'\e[1;33m'
export LESS_TERMCAP_me=$'\e[0m'

# Don’t clear the screen after quitting a manual page
export MANPAGER="less -X"

# Homebrew: no hints about environment variables after every install
export HOMEBREW_NO_ENV_HINTS=1
